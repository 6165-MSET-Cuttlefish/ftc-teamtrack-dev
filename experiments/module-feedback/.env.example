# ─────────────────────────────────────────────────────────────────────────────
# module-feedback (POC) — environment configuration
#
# Copy to `.env` and fill in. `.env` is gitignored. This POC is standalone and
# shares NOTHING with the TeamTrack website's Firebase config.
# ─────────────────────────────────────────────────────────────────────────────

# --- Gemini API (Method 1 analysis pass + Method 3 robotics model) ---
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Google Cloud (Method 1 object-tracking pass via Video Intelligence API) ---
# The Video Intelligence API reads video from a Google Cloud Storage bucket, so
# you need a GCP project, a bucket, and Application Default Credentials.
#   1. gcloud auth application-default login   (or set the key file path below)
#   2. Enable the Video Intelligence API on the project.
GOOGLE_CLOUD_PROJECT=
# Bucket the CLI uploads local clips to before tracking (no gs:// prefix, just the name).
GCS_BUCKET=
# Optional: path to a service-account JSON key. If unset, Application Default
# Credentials are used (the gcloud login above).
GOOGLE_APPLICATION_CREDENTIALS=

# --- TwelveLabs (Method 2 — no Gemini/GCP needed; has a free plan) ---
# Create a free key at https://playground.twelvelabs.io/dashboard/api-keys
# (Free plan, no credit card; 600 min shared across indexing + analysis). The $0 path.
TWELVELABS_API_KEY=
# Pegasus is the generative model that writes the analysis. pegasus1.2 (default)
# or pegasus1.5.
TWELVELABS_MODEL=pegasus1.2
# The CLI reuses one index across runs. It creates this by name on first run;
# set an explicit index id to skip the name lookup.
TWELVELABS_INDEX_NAME=ftc-module-feedback
TWELVELABS_INDEX_ID=

# --- Model IDs (override to taste) ---
# The planning doc references "Gemini 3 Flash". gemini-3.5-flash is the current
# stable multimodal Flash model; gemini-3-flash-preview / gemini-2.5-flash also work.
GEMINI_ANALYSIS_MODEL=gemini-3.5-flash
# Method 3 — Google's robotics embodied-reasoning model (fixed by the plan).
GEMINI_ROBOTICS_MODEL=gemini-robotics-er-1.6-preview

# --- Video sampling ---
# The whole point of the API path (per the plan) is escaping the app's 1-FPS
# ceiling. Gemini samples video at 1 FPS by default; bump this to capture fast
# mechanism motion. Higher = more detail + more tokens/cost.
GEMINI_VIDEO_FPS=5

# Video Intelligence region (us-east1 / us-west1 / europe-west1 ...).
VIDEO_INTELLIGENCE_LOCATION=us-east1

# ─────────────────────────────────────────────────────────────────────────────
# Fine-tuning track (tuning/ — see tuning/PLAN.md)
#
# IMPORTANT: video tuning is Vertex AI only. A GEMINI_API_KEY is NOT enough —
# you need GOOGLE_CLOUD_PROJECT with billing enabled plus a bucket. Phase 2
# (`yarn tuning prepare` + `yarn tuning evaluate`) works without any of this.
# ─────────────────────────────────────────────────────────────────────────────

# Vertex region for the tuning job. us-central1 has the widest model coverage.
VERTEX_LOCATION=us-central1

# Base model. Only Gemini 2.5 (pro / flash / flash-lite) is publicly tunable —
# Gemini 3 tuning is enterprise-only. Note this is a step DOWN from the
# gemini-3.5-flash the other methods use; `evaluate` accounts for that.
TUNING_BASE_MODEL=gemini-2.5-flash

# 64 tokens/frame, 20-min clip cap. MEDIA_RESOLUTION_MEDIUM is 256 tokens/frame
# and drops the cap to 5 min. Must be the same on every line of the dataset —
# changing it means rebuilding train.jsonl AND val.jsonl together.
TUNING_MEDIA_RESOLUTION=MEDIA_RESOLUTION_LOW

# Bucket for clips + datasets. Defaults to GCS_BUCKET above.
TUNING_BUCKET=
TUNING_GCS_PREFIX=module-feedback/tuning

# Split fractions. eval is held out from training entirely (human grading);
# val is the Vertex validation set carved from what remains.
TUNING_EVAL_FRACTION=0.2
TUNING_VAL_FRACTION=0.15

# Display name prefix for the tuned model in the Vertex console.
TUNING_DISPLAY_NAME=ftc-module-feedback

# Filled in AFTER a job succeeds — `yarn tuning status` prints the line to paste.
TUNED_MODEL_ENDPOINT=
