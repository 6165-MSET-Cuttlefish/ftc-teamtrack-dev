rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Sessions — owner can always read/write; team members can read team sessions
    match /sessions/{sessionId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        resource.data.teamId != null
      );
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Shared session snapshots — anyone can read, any authenticated user can create
    match /sharedSessions/{shortId} {
      allow read: if true;
      allow create: if request.auth != null;
      // No update/delete — snapshots are immutable
    }

    // Teams — any authenticated user can read (needed for invite code lookups and
    // getUserTeams which filters client-side). Creator sets createdBy on create.
    // Any authenticated user can update (needed for join/leave/transfer/kick).
    match /teams/{teamId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;
    }
  }
}
