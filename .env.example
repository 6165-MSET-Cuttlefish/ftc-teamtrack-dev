# TeamTrack — Environment Variables
#
# Copy this file to .env and fill in your Firebase project values.
# Get these from https://console.firebase.google.com → Project Settings → General → Your apps
#
# Never commit your actual .env file to version control.

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Video Analysis feature — robot video upload + Gemini tracking/coaching.
# Cloudinary: free tier, no card required. Create an unsigned upload
# preset (Settings → Upload → Upload presets) that allows resource_type
# "video" at https://cloudinary.com/console.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# URL of the deployed Cloudflare Worker that proxies Gemini API calls
# (see worker/README.md for setup — `wrangler deploy` from worker/).
VITE_GEMINI_WORKER_URL=https://your-worker.your-subdomain.workers.dev
