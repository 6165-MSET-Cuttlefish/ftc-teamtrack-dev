# Local testing against the Firebase emulators (never the real project).
#   npx firebase-tools emulators:start --only auth,firestore --project demo-teamtrack
#   npx vite --mode emulator
# A "demo-" project ID can only ever reach the emulators.
VITE_USE_EMULATOR=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-teamtrack.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-teamtrack
VITE_FIREBASE_STORAGE_BUCKET=demo-teamtrack.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_FIREBASE_MEASUREMENT_ID=
